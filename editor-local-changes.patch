index 30b19dd3..ed78bf22 100644
--- a/excalidraw-app/excalidrawZ/camera.js
+++ b/excalidraw-app/excalidrawZ/camera.js
@@ -282,25 +282,36 @@ export const onCameraChange = (callback) => {
  * Should be called once after excalidrawAPI is ready.
  * Deduplicates consecutive equal values to avoid spam from unrelated re-renders.
  */
+let stopCameraTracking = null;
+
 export const startCameraTracking = () => {
+  stopCameraTracking?.();
   const api = getAPI();
   if (!api) {
     return;
   }
-  let lastX = null;
-  let lastY = null;
-  let lastZoom = null;
-  api.onScrollChange((scrollX, scrollY, zoom) => {
-    const z = zoom.value;
-    if (scrollX === lastX && scrollY === lastY && z === lastZoom) {
-      return;
-    }
-    lastX = scrollX;
-    lastY = scrollY;
-    lastZoom = z;
-    sendMessage({
-      event: "onCameraChanged",
-      data: { scrollX, scrollY, zoom: z },
-    });
+  let last = null;
+  let pending = null;
+  let timer = null;
+  const flush = () => {
+    timer = null;
+    if (!pending) return;
+    const camera = pending;
+    pending = null;
+    if (last && camera.scrollX === last.scrollX &&
+        camera.scrollY === last.scrollY && camera.zoom === last.zoom) return;
+    last = camera;
+    sendMessage({ event: "onCameraChanged", data: camera });
+  };
+  const unsubscribe = api.onScrollChange((scrollX, scrollY, zoom) => {
+    pending = { scrollX, scrollY, zoom: zoom.value };
+    // Native only needs a recent fallback; explicit getCamera reads stay exact.
+    if (timer === null) timer = setTimeout(flush, 100);
   });
+  stopCameraTracking = () => {
+    if (timer !== null) clearTimeout(timer);
+    pending = null;
+    unsubscribe?.();
+  };
+  return stopCameraTracking;
 };
diff --git a/excalidraw-app/excalidrawZ/camera.test.js b/excalidraw-app/excalidrawZ/camera.test.js
new file mode 100644
index 00000000..bc5b2da9
--- /dev/null
+++ b/excalidraw-app/excalidrawZ/camera.test.js
@@ -0,0 +1,44 @@
+import { startCameraTracking } from "./camera";
+
+describe("native camera sampling", () => {
+  let callback;
+  let stop;
+  let postMessage;
+  beforeEach(() => {
+    vi.useFakeTimers();
+    postMessage = vi.fn();
+    window.webkit = { messageHandlers: { excalidrawZ: { postMessage } } };
+    window.excalidrawZHelper = { _api: { onScrollChange: vi.fn((cb) => {
+      callback = cb;
+      return vi.fn();
+    }) } };
+    stop = startCameraTracking();
+  });
+  afterEach(() => {
+    stop();
+    vi.useRealTimers();
+    delete window.webkit;
+    delete window.excalidrawZHelper;
+  });
+  it("coalesces rapid updates and delivers the final camera", () => {
+    for (let i = 0; i < 120; i++) {
+      callback(i, i * 2, { value: 1.5 });
+      vi.advanceTimersByTime(8);
+    }
+    vi.advanceTimersByTime(100);
+    expect(postMessage.mock.calls.length).toBeLessThanOrEqual(10);
+    expect(postMessage).toHaveBeenLastCalledWith({ event: "onCameraChanged",
+      data: { scrollX: 119, scrollY: 238, zoom: 1.5 } });
+  });
+  it("does not deliver duplicates or pending updates after stop", () => {
+    callback(10, 20, { value: 1 });
+    vi.advanceTimersByTime(100);
+    callback(10, 20, { value: 1 });
+    vi.advanceTimersByTime(100);
+    expect(postMessage).toHaveBeenCalledTimes(1);
+    callback(30, 40, { value: 2 });
+    stop();
+    vi.advanceTimersByTime(100);
+    expect(postMessage).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/excalidraw-app/excalidrawZ/desktopControls.test.ts b/excalidraw-app/excalidrawZ/desktopControls.test.ts
new file mode 100644
index 00000000..9e2354da
--- /dev/null
+++ b/excalidraw-app/excalidrawZ/desktopControls.test.ts
@@ -0,0 +1,13 @@
+import { deriveStylesPanelMode, getFormFactor } from "@excalidraw/common";
+
+it("retains desktop controls in a medium desktop window", () => {
+  expect(getFormFactor(900, 700)).toBe("desktop");
+  expect(deriveStylesPanelMode({
+    formFactor: getFormFactor(900, 700), desktopUIMode: "full",
+    userAgent: { isMobileDevice: false, platform: "other" },
+    isTouchScreen: false, canFitSidebar: false, isLandscape: true,
+  })).toBe("full");
+});
+it("retains the mobile fallback for genuinely narrow windows", () => {
+  expect(getFormFactor(500, 700)).toBe("phone");
+});
